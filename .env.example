# Copier ce fichier vers .env et renseigner les valeurs (ne jamais committer .env)
#
# Clé API DeepSeek (obligatoire pour la reformulation côté app.py)
DEEPSEEK_API_KEY=

# Optionnel : proxy / endpoint compatible OpenAI
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_TIMEOUT_S=20

# Token pour l’endpoint POST /refresh_index (recommandé en production)
REFRESH_TOKEN=

# Désactiver le chargement SentenceTransformer (tests sans modèle)
# SKIP_MODEL=1

# URL de base de l'API WordPress REST (pour la liste des pages dans /admin/wp-pages)
WP_API_BASE=https://demdikk.sn/wp-json/wp/v2

# (Optionnel) Si Flask doit écrire dans WP via API REST authentifiée
# WP_APP_USERNAME=votre_user_wp
# WP_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx
