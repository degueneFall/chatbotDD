# Copier ce fichier vers .env et renseigner les valeurs (ne jamais committer .env)
#
# Clé API DeepSeek (obligatoire pour la reformulation côté app.py)
DEEPSEEK_API_KEY=

# Optionnel : proxy / endpoint compatible OpenAI
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_TIMEOUT_S=20

# Token pour l’endpoint POST /refresh_index (recommandé en production)
REFRESH_TOKEN=

# Désactiver le chargement SentenceTransformer (tests sans modèle)
